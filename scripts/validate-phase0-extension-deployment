#!/bin/zsh

set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
    print -u2 "Usage: $0 APP_PATH [EXPECTED_TEAM_ID] [--require-notarization]"
    exit 64
fi

app_path="$1"
expected_team_id="${2:-}"
notarization_mode="${3:-}"
service_path="$app_path/Contents/XPCServices/foofoilTestExtensionService.xpc"

if [[ ! -d "$app_path" || ! -d "$service_path" ]]; then
    print -u2 "Missing app or embedded Test Extension XPC service."
    exit 66
fi

codesign --verify --deep --strict --all-architectures --verbose=2 "$app_path"
codesign --verify --strict --all-architectures --verbose=2 "$service_path"

app_signature="$(codesign -dvvv "$app_path" 2>&1)"
service_signature="$(codesign -dvvv "$service_path" 2>&1)"
if [[ "$app_signature" != *"flags=0x10000(runtime)"* || "$service_signature" != *"flags=0x10000(runtime)"* ]]; then
    print -u2 "Host and XPC service must both enable Hardened Runtime."
    exit 65
fi

app_entitlements="$(codesign -d --entitlements :- "$app_path" 2>/dev/null)"
service_entitlements="$(codesign -d --entitlements :- "$service_path" 2>/dev/null)"
if [[ "$app_entitlements" != *"com.apple.security.app-sandbox"* || "$service_entitlements" != *"com.apple.security.app-sandbox"* ]]; then
    print -u2 "Host and XPC service must both enable App Sandbox."
    exit 65
fi
if [[ "$app_entitlements" == *"com.apple.security.cs.disable-library-validation"* ]]; then
    print -u2 "The host must not disable Library Validation."
    exit 65
fi

if [[ -n "$expected_team_id" ]]; then
    app_team="${${(M)${(f)app_signature}:#TeamIdentifier=*}#TeamIdentifier=}"
    service_team="${${(M)${(f)service_signature}:#TeamIdentifier=*}#TeamIdentifier=}"
    if [[ "$app_team" != "$expected_team_id" || "$service_team" != "$expected_team_id" ]]; then
        print -u2 "Unexpected Team ID (host=$app_team, service=$service_team)."
        exit 65
    fi
fi

spctl --assess --type execute --verbose=2 "$app_path"
if [[ "$notarization_mode" == "--require-notarization" ]]; then
    xcrun stapler validate "$app_path"
fi

print "Phase 0 deployment validation passed."
