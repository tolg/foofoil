{
  "id": "app.foofoil.extension.test",
  "name": "Test Extension",
  "version": "1.0.0",
  "extensionAPI": {"min": 1, "max": 1},
  "system": {"minMacOS": "15.0", "architectures": ["arm64", "x86_64"]},
  "providers": [
    {
      "id": "test.content",
      "role": "primary",
