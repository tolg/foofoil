{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foofoil.app/schemas/extension-manifest-v1.json",
  "title": "foofoil Extension Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "extensionAPI", "system", "providers", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*){2,}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "extensionAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minMacOS", "architectures"],
      "properties": {
        "minMacOS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["arm64", "x86_64"]}}
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "contentTypes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "override"]},
          "fallbackProvider": {"type": "string", "minLength": 1},
          "enhancementDomain": {"type": "string", "minLength": 1},
          "contentTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy"],
              "properties": {
                "extensions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+$"}},
                "utTypes": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "strategy": {"enum": ["extension", "conforms", "sniff"]}
              },
              "anyOf": [{"required": ["extensions"]}, {"required": ["utTypes"]}]
            }
          }
        },
        "allOf": [{"if": {"properties": {"role": {"const": "override"}}}, "then": {"required": ["fallbackProvider"]}}]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contractVersion", "scope"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "contractVersion": {"type": "integer", "minimum": 1},
              "scope": {"enum": ["application", "session", "presentation"]},
              "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    }
  }
}
